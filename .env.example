# Copy to .env and fill in – docker compose reads it automatically. .env is git-ignored.

# Base URL of the API under test (default: the demo API container)
BASE_URL=https://api.example.com

# Secrets referenced from endpoints.yaml as ${API_TOKEN}
API_TOKEN=

# Teams / Slack incoming webhooks
ALERT_WEBHOOK_URL=
ESCALATION_WEBHOOK_URL=

# Host port for the HTML status page
STATUS_PAGE_PORT=8080
